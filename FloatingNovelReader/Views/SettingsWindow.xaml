<Window x:Class="FloatingNovelReader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FloatingNovelReader.Controls"
        xmlns:conv="clr-namespace:FloatingNovelReader.Converters"
        Title="设置"
        Width="600" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="White"
        AutomationProperties.Name="设置窗口"
        AutomationProperties.HelpText="配置阅读器显示、自动阅读、启动行为和快捷键">
    <Window.Resources>
        <conv:BackgroundPresetToStringConverter x:Key="BackgroundPresetConverter"/>
        <conv:EnumDisplayNameConverter x:Key="EnumDisplayConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    AutomationProperties.Name="设置选项卡"
                    AutomationProperties.HelpText="在显示、自动阅读、启动、快捷键等设置类别之间切换">
            <!-- 显示设置 -->
            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="字体族" Margin="0,8,0,4"/>
                        <ComboBox x:Name="FontFamilyCombo" SelectedValuePath="FamilyName"
                                  SelectedValue="{Binding Current.Display.FontFamily}"
                                  ItemsSource="{Binding FontFamilies}"
                                  AutomationProperties.Name="字体族选择"
                                  AutomationProperties.HelpText="选择阅读文本的字体">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="ToolTip" Value="字体未安装，选中后将使用系统默认字体渲染"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="字体大小" Margin="0,8,0,4"/>
                        <Slider Minimum="12" Maximum="48" TickFrequency="1"
                                Value="{Binding Current.Display.FontSize}" IsSnapToTickEnabled="True"/>
                        <TextBlock>
                            <Run Text="{Binding Current.Display.FontSize, Mode=OneWay}"/><Run Text=" px"/>
                        </TextBlock>

                        <TextBlock Text="字体样式" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="粗体" IsChecked="{Binding Current.Display.FontBold}" Margin="0,0,12,0"/>
                            <CheckBox Content="斜体" IsChecked="{Binding Current.Display.FontItalic}"/>
                        </StackPanel>

                        <TextBlock Text="字体颜色" Margin="0,8,0,4"/>
                        <ComboBox SelectedItem="{Binding Current.Display.FontColorPreset}"
                                  ItemsSource="{Binding FontColorPresets}"/>

                        <TextBlock Text="行间距" Margin="0,8,0,4"/>
                        <Slider Minimum="1.0" Maximum="2.5" TickFrequency="0.1"
                                Value="{Binding Current.Display.LineHeight}" IsSnapToTickEnabled="True"/>
                        <TextBlock>
                            <Run Text="{Binding Current.Display.LineHeight, Mode=OneWay}"/><Run Text=" x"/>
                        </TextBlock>

                        <TextBlock Text="背景颜色" Margin="0,8,0,4"/>
                        <ComboBox x:Name="BackgroundCombo" SelectedItem="{Binding Current.Display.BackgroundPreset}"
                                  ItemsSource="{Binding BackgroundPresets}"
                                  AutomationProperties.Name="背景颜色选择"
                                  AutomationProperties.HelpText="选择阅读区域背景颜色">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource BackgroundPresetConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="透明度" Margin="0,8,0,4">
                            <Run Text="← 透明"/>
                            <Run Text="  "/>
                            <Run Text="不透明 →"/>
                        </TextBlock>
                        <Slider Minimum="0.2" Maximum="1.0" TickFrequency="0.01"
                                Value="{Binding Current.Display.Opacity}" IsSnapToTickEnabled="True"/>
                        <TextBlock>
                            <Run Text="{Binding Current.Display.Opacity, StringFormat={}0%}"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 自动阅读 -->
            <TabItem Header="自动阅读">
                <StackPanel Margin="12">
                    <TextBlock Text="自动翻页间隔（秒）" Margin="0,8,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="1" Maximum="60" TickFrequency="1"
                                Value="{Binding AutoReadIntervalSec}" IsSnapToTickEnabled="True"
                                Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding AutoReadIntervalSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" HorizontalContentAlignment="Center"
                                 PreviewTextInput="OnNumberOnly"
                                 DataObject.Pasting="OnPasteNumberOnly"/>
                    </Grid>
                    <TextBlock>
                        <Run Text="{Binding AutoReadIntervalSec, Mode=OneWay}"/><Run Text=" 秒"/>
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- 启动 -->
            <TabItem Header="启动">
                <StackPanel Margin="12">
                    <TextBlock Text="启动时" Margin="0,8,0,4"/>
                    <ComboBox SelectedItem="{Binding Current.StartupBehavior}"
                              ItemsSource="{Binding StartupOptions}"
                              AutomationProperties.Name="启动行为选择"
                              AutomationProperties.HelpText="选择程序启动时的行为">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Content="开机自动启动" IsChecked="{Binding Current.AutoStart}" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 快捷键 -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="快捷键模式" Margin="0,8,0,4"/>
                        <ComboBox SelectedItem="{Binding Current.HotkeyMode}"
                                  ItemsSource="{Binding HotkeyModeOptions}"
                                  AutomationProperties.Name="快捷键模式选择"
                                  AutomationProperties.HelpText="选择快捷键是全局生效还是仅在阅读窗口激活时生效">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="建议在编辑文档时使用「仅在本程序窗口激活时生效」" 
                                   Foreground="Gray" FontSize="11" Margin="0,4,0,12"/>

                        <ItemsControl x:Name="HotkeyList" Margin="0,0,0,0"
                                      AutomationProperties.Name="快捷键列表"
                                      AutomationProperties.HelpText="配置全局快捷键，点击输入框后按下对应按键">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        <ctrl:HotkeyTextBox Grid.Column="1"
                                                            Hotkey="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="导出设置" Padding="16,6" Margin="6,0" Click="OnExport"
                    AutomationProperties.Name="导出设置按钮"
                    AutomationProperties.HelpText="将所有设置和书架数据库备份到桌面文件夹"/>
            <Button Content="导入设置" Padding="16,6" Margin="6,0" Click="OnImport"
                    AutomationProperties.Name="导入设置按钮"
                    AutomationProperties.HelpText="从备份文件夹恢复设置"/>
            <Button Content="恢复默认" Padding="16,6" Margin="6,0" Click="OnReset"
                    AutomationProperties.Name="恢复默认按钮"
                    AutomationProperties.HelpText="将所有设置恢复为默认值"/>
            <Button Content="取消" Padding="16,6" Margin="6,0" Click="OnCancel"
                    AutomationProperties.Name="取消按钮"
                    AutomationProperties.HelpText="取消更改并关闭设置"/>
            <Button Content="保存" Padding="16,6" Margin="6,0" Click="OnSave"
                    AutomationProperties.Name="保存按钮"
                    AutomationProperties.HelpText="保存设置并关闭"/>
        </StackPanel>
    </Grid>
</Window>
