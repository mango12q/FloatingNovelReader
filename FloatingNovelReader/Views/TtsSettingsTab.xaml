<UserControl x:Class="FloatingNovelReader.Views.TtsSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="560">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- 声音 -->
            <TextBlock Text="声音" FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Voices}"
                          SelectedValuePath="ShortName"
                          DisplayMemberPath="Display"
                          SelectedValue="{Binding Voice, Mode=TwoWay}"
                          AutomationProperties.Name="朗读声音"/>
                <Button Grid.Column="1" Content="刷新列表" Margin="8,0,0,0" Padding="10,2"
                        Command="{Binding LoadVoicesCommand}"
                        AutomationProperties.Name="刷新声音列表"/>
            </Grid>

            <!-- 语速 -->
            <TextBlock Text="语速" FontWeight="Bold" Margin="0,16,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="-50" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding RatePercent, Mode=TwoWay}"
                        AutomationProperties.Name="朗读语速"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding RatePercent, StringFormat={}{0:F0}%}"/>
            </Grid>
            <TextBlock Text="负数更慢，正数更快（−50% ~ +100%）" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>

            <!-- 音量 -->
            <TextBlock Text="音量" FontWeight="Bold" Margin="0,16,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="-50" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding VolumePercent, Mode=TwoWay}"
                        AutomationProperties.Name="朗读音量"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding VolumePercent, StringFormat={}{0:F0}%}"/>
            </Grid>

            <!-- 联动 -->
            <CheckBox Content="朗读时让阅读位置跟随音频" Margin="0,16,0,0"
                      IsChecked="{Binding AutoAdvancePage, Mode=TwoWay}"
                      AutomationProperties.Name="朗读时自动翻页"/>

            <!-- 两种停止条件的默认值（菜单入口直接取这里的值） -->
            <TextBlock Text="停止条件默认值" FontWeight="Bold" Margin="0,16,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="朗读 N 分钟：" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="6,0,0,0"
                         Text="{Binding MaxMinutesDefault, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PreviewTextInput="OnNumberOnly" DataObject.Pasting="OnPasteNumberOnly"
                         AutomationProperties.Name="朗读分钟数默认值"/>
                <TextBlock Grid.Column="2" Text="朗读 N 章：" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox Grid.Column="3" Margin="6,0,0,0"
                         Text="{Binding MaxChaptersDefault, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PreviewTextInput="OnNumberOnly" DataObject.Pasting="OnPasteNumberOnly"
                         AutomationProperties.Name="朗读章节数默认值"/>
            </Grid>
            <TextBlock Text="分钟数到点停在段末；章节数到点停在章末" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>

            <!-- 试听 -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="试听" Padding="14,3" Command="{Binding PreviewCommand}"
                        AutomationProperties.Name="试听当前声音"/>
                <Button Content="停止试听" Padding="14,3" Margin="8,0,0,0" Command="{Binding StopPreviewCommand}"
                        AutomationProperties.Name="停止试听"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="Gray" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <!-- 说明 -->
            <Border Margin="0,20,0,0" Padding="10" Background="#F5F5F5" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="怎么用" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                        <Run Text="· 阅读窗口的 ≡ 菜单里有四项：『从当前开始朗读』（播到全书末）、『朗读 N 分钟』、『朗读 N 章』、『停止朗读』。"/>
                        <LineBreak/>
                        <Run Text="· 『朗读 N 分钟』到点停在段末，状态栏实时显示剩余时间；『朗读 N 章』播完 N 章停在章末。N 取上面两个输入框的值。"/>
                        <LineBreak/>
                        <Run Text="· 想用快捷键：切到『快捷键』标签页，给『从当前开始朗读』『停止朗读』录一个按键即可（默认未绑定）。"/>
                        <LineBreak/>
                        <Run Text="· 朗读按段落切片合成后顺序播放，播完一段自动合成下一段；一章播完自动续下一章。"/>
                        <LineBreak/>
                        <Run Text="· 与『自动阅读』互斥：开始朗读会自动停掉自动阅读，结束后恢复它原来的状态。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
