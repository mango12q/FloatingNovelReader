<Window x:Class="FloatingNovelReader.Views.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书签列表"
        Width="500" Height="600"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontSize="{x:Static SystemFonts.MessageFontSize}"
        AutomationProperties.Name="书签列表"
        AutomationProperties.HelpText="查看和管理当前书籍的书签">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="BookTitleText" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}" FontWeight="Bold" Margin="6"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BookmarkList"
                          AutomationProperties.Name="书签列表"
                          AutomationProperties.HelpText="点击书签跳转到对应页面">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="6" Cursor="Hand"
                                MouseLeftButtonUp="OnBookmarkClick" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Note}" FontWeight="Bold"/>
                                    <TextBlock>
                                        <Run Text="第 " />
                                        <Run Text="{Binding PageNumber, Mode=OneWay}"/>
                                        <Run Text=" 页" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding CreatedTime, StringFormat='yyyy-MM-dd HH:mm'}" Foreground="Gray"/>
                                </StackPanel>
                                 <Button Grid.Column="1" Content="删除" Padding="8,2" VerticalAlignment="Center"
                                         Click="OnRemoveClick" Tag="{Binding}"
                                         AutomationProperties.Name="删除书签按钮"
                                         AutomationProperties.HelpText="删除此条书签"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
