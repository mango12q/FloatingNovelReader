<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>FloatingNovelReader.Tests</RootNamespace>
    <AssemblyName>FloatingNovelReader.Tests</AssemblyName>
    <!-- 与主项目分到独立目录，彻底避免 obj/ 锁冲突 -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloatingNovelReader\FloatingNovelReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- XAML 绑定守卫测试要在运行时读源码 XAML（编译产物里只有 BAML） -->
    <None Include="..\FloatingNovelReader\Views\*.xaml"
          Link="Views\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- 发布脚本编码守卫 + 产物名一致性守卫要读源文件 -->
    <None Include="..\Build\build.ps1"
          Link="Build\build.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md"
          Link="Build\README.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
